	seismic/$(DEPDIR)/$(am__dirstamp)
seismic/seismic_kdiff_func.$(OBJEXT): seismic/$(am__dirstamp) \
	seismic/$(DEPDIR)/$(am__dirstamp)
main/$(am__dirstamp):
	@$(MKDIR_P) main
	@: > main/$(am__dirstamp)
main/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) main/$(DEPDIR)
	@: > main/$(DEPDIR)/$(am__dirstamp)
main/CTEM.$(OBJEXT): main/$(am__dirstamp) \
	main/$(DEPDIR)/$(am__dirstamp)
CTEM$(EXEEXT): $(CTEM_OBJECTS) $(CTEM_DEPENDENCIES) 
	@rm -f CTEM$(EXEEXT)
	$(FCLINK) $(CTEM_OBJECTS) $(CTEM_LDADD) $(LIBS)

